<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/glitch_bg">

    <!-- Title -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="120dp"
        android:text="GLITCH HOLLOW"
        android:textColor="@color/glitch_cyan"
        android:textSize="36sp"
        android:textStyle="bold"
        android:letterSpacing="0.2"
        android:fontFamily="monospace" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tv_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/tv_title"
        android:layout_marginTop="8dp"
        android:text="escape the signal"
        android:textColor="@color/glitch_purple"
        android:textSize="14sp"
        android:fontFamily="monospace" />

    <!-- Play button -->
    <TextView
        android:id="@+id/btn_play"
        android:layout_width="200dp"
        android:layout_height="56dp"
        android:layout_centerInParent="true"
        android:layout_marginTop="80dp"
        android:gravity="center"
        android:text="▶  PLAY"
        android:textColor="@color/glitch_bg"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:background="@color/glitch_cyan"
        android:clickable="true"
        android:focusable="true" />

    <!-- Version -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="24dp"
        android:text="v1.0 — glitch hollow"
        android:textColor="#44FFFFFF"
        android:textSize="11sp"
        android:fontFamily="monospace" />

</RelativeLayout>